<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- User Manager Menu -->
    <menuitem id="menu_limited_user_manager_root" 
              name="User Management" 
              sequence="10"
              groups="base_hospital_management.base_hospital_management_group_limited_user_manager"/>
    
    <!-- Users Action -->
    <record id="action_limited_user_manager_users" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new user
            </p>
        </field>
    </record>
    
    <!-- Users Menu -->
    <menuitem id="menu_limited_user_manager_users" 
              name="Users" 
              parent="menu_limited_user_manager_root"
              action="action_limited_user_manager_users"
              sequence="10"
              groups="base_hospital_management.base_hospital_management_group_limited_user_manager"/>
</odoo>