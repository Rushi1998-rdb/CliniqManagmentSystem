<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--    Hospital outpatient tree view-->
    <record id="hospital_outpatient_view_tree" model="ir.ui.view">
        <field name="name">hospital.outpatient.view.tree</field>
        <field name="model">hospital.outpatient</field>
        <field name="arch" type="xml">
            
            <tree
                default_order="sort_priority asc, visit_time_minutes asc"
                decoration-success="patient_queue_type == 'new'"
                decoration-info="patient_queue_type == 'revisit'"
                decoration-muted="state == 'done'"
            >
                <field name="visit_time" column_invisible="True"/>
                <field name="patient_queue_type" column_invisible="True"/>
                <field name="sort_priority" column_invisible="True"/>
                <field name="visit_time_minutes" column_invisible="True"/>
                <field name="op_reference" string="OP Reference"/>
                <field name="slot"/>
                <!-- <field name="patient_id"/> -->
                <field name="display_patient_name" string="Patient"/>
                <field name="doctor_id"/>
                <field name="op_date"/>
                <field name="reason"/>
                <!-- <field name="state" widget='badge'
                       decoration-success="state=='done'"
                       decoration-danger="state=='cancel'"
                       decoration-warning="state=='draft'"
                       decoration-info="state=='op'"/> -->
                <field name="state" widget="badge"
                    decoration-danger="state == 'waiting'"
                    decoration-warning="state == 'op'"
                    decoration-muted="state == 'done'"/>
                <field name="patient_place" string="Place"/>
                <field name="payment_mode"/>
                <field name="visit_time_local" string="Visit Time"/>
                <field name="general_fee"/>
                <!-- <field name="lab_test_charge"/> -->
                <field name="total_amount"/>
                <field name="invoice_due_amount"/>
                <field name="total_due_amount"/>
                <!-- <field name="state" widget='badge'
                       decoration-success="state=='invoiced'"
                       decoration-danger="state=='cancel'"
                       decoration-warning="state=='draft'"
                       decoration-info="state=='op'"/>
                <field name="general_fee"/> -->
            </tree>
        </field>
    </record>
