<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prescription_line_view_tree_readonly" model="ir.ui.view">
        <field name="name">prescription.line.view.tree.readonly</field>
        <field name="model">prescription.line</field>
        <field name="arch" type="xml">
            <tree string="Prescription" create="false" edit="false" delete="false">
                <field name="medicine_id"/>
                <field name="no_intakes"/>
                <field name="selected_times" widget="many2many_tags"/>
                <!-- <field name="custom_schedule"/> -->
                <field name="days"/>
                <field name="quantity"/>
            </tree>
        </field>
    </record>

    <record id="prescription_line_view_form_readonly" model="ir.ui.view">
        <field name="name">prescription.line.view.form.readonly</field>
        <field name="model">prescription.line</field>
        <field name="arch" type="xml">
            <form string="Prescription" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="outpatient_id" readonly="1"/>
                            <!-- <field name="inpatient_id" readonly="1"/> -->
                        </group>
                        <group>
                            <field name="medicine_id" readonly="1"/>
                            <field name="no_intakes" readonly="1"/>
                            <field name="selected_times" widget="many2many_tags" readonly="1"/>
                            <field name="custom_schedule" readonly="1"/>
                            <field name="days" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
