<odoo>

    <record id="hospital_lab_test_tree" model="ir.ui.view">
        <field name="name">hospital.lab.test.tree</field>
        <field name="model">hospital.lab.test</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="normal_range"/>
            </tree>
        </field>
    </record>

    <record id="hospital_lab_test_form" model="ir.ui.view">
        <field name="name">hospital.lab.test.form</field>
        <field name="model">hospital.lab.test</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="normal_range"/>
                        <field name="description"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_lab_test_action" model="ir.actions.act_window">
        <field name="name">Lab Tests</field>
        <field name="res_model">hospital.lab.test</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>