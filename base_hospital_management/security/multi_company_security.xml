            <field name="global" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('base_hospital_management.base_hospital_management_group_manager') or user.has_group('base_hospital_management.base_hospital_management_group_receptionist') else ['|', '|', ('id', '=', False), ('create_uid', '=', user.id), ('move_id.outpatient_id.doctor_id.doctor_id.user_id', '=', user.id)]</field>
