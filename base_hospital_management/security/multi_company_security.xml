        <!-- Strict Global Isolation: Users can only see invoices they created or are assigned to, EXCEPT Managers -->
        <record id="account_move_strict_global_isolation" model="ir.rule">
            <field name="name">Account Move: Strict Global Isolation</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('base_hospital_management.base_hospital_management_group_manager') or user.has_group('base_hospital_management.base_hospital_management_group_receptionist') else ['|', '|', ('id', '=', False), ('create_uid', '=', user.id), ('outpatient_id.doctor_id.doctor_id.user_id', '=', user.id)]</field>
        </record>

