        <!-- Strictest Multi-Company Rule for Partners (res.partner) -->
        <record id="res_partner_patient_rule_company" model="ir.rule">
            <field name="name">Partner: Strict Multi-Company Isolation</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', '|', '|', '|', '|', ('company_id', '=', False), ('id', '=', user.partner_id.id), ('id', '=', user.company_id.partner_id.id), ('is_company', '=', True), ('company_id', 'in', company_ids), ('user_ids.company_ids', 'in', company_ids)]</field>
        </record>

        <!-- Specific Rule to hide Partners of Users from other companies -->
        <record id="res_partner_user_link_rule" model="ir.rule">
            <field name="name">Partner: Hide Staff from Other Companies</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', '|', ('id', '=', user.partner_id.id), ('user_ids', '=', False), ('user_ids.company_ids', 'in', company_ids)]</field>
        </record>

